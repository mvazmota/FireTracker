{
  // Firepath: a Worker that serves the built SPA and the /api routes.
  // Deploy with: npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firetracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Always let the Worker handle API calls, even though they match no asset.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firepath-db",
      "database_id": "d3c05e4a-3daa-4d33-82cf-6739b1180cbc"
    }
  ],

  "vars": {
    // Comma-separated list of origins allowed to call the auth endpoints.
    "TRUSTED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787,http://localhost:5199,http://127.0.0.1:5199,https://firetracker.m-vaz-mota.workers.dev",

    // Sender for password reset emails. Replace with an address on a domain you
    // have verified with Resend, e.g. "Firepath <noreply@yourdomain.com>".
    // The default only delivers to your own Resend account address.
    "MAIL_FROM": "Firepath <onboarding@resend.dev>"
  },

  "observability": {
    "enabled": true
  }
}
